generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth & Tenancy ───────────────────────────────────────────

enum UiVersion {
  V1
  V2
}

enum Language {
  en
  zh
}

model Agent {
  id           String         @id @default(cuid())
  email        String         @unique
  password     String?        // bcrypt hashed. Null for OAuth agents (future)
  name         String
  isApproved   Boolean        @default(false)
  isSuperAdmin Boolean        @default(false)
  maxBranches  Int            @default(1)
  onlinePayment Boolean  @default(false) // admin opt-in: auto invoices + Billplz Pay now
  // Which app the account uses. V1 is frozen; V2 is the config-driven payroll.
  // Default flips to V2 once v2 has screens to land on.
  uiVersion    UiVersion      @default(V1)
  // v2 UI language chosen by the user; null = use the cookie or browser language.
  language     Language?
  // Onboarding tour. False only for agents created after the onboarding
  // migration — gates the first-sign-in demo seed + auto-started tour.
  hasSeenTutorial Boolean     @default(false)
  branches     Branch[]
  accounts     Account[]
  sessions     Session[]
  defaults              AgentDefault[]
  paymentRecords        PaymentRecord[]
  invoices              Invoice[]
  branchLimitChanges    BranchLimitChange[]
  notifications         Notification[]
  employees             Employee[]
  dispatchers           Dispatcher[]
  payRules              PayRule[]
  payrollRuns           PayrollRun[]
  ruleAudits            RuleAudit[]
  penaltyImports        PenaltyImport[]
  penaltyItems          PenaltyItem[]
  penaltyAliases        PenaltyAlias[]
  payrollChecks         PayrollCheck[]
  companyRegistrationNo    String?
  companyAddress           String?
  avatarUrl                String?    // R2 URL for profile picture
  stampImageUrl            String?    // R2 URL for company stamp on payslips
  phone                    String?    // WhatsApp number, collected at signup
  adminNotes               String?    // superadmin-only notes
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt
}

model AgentDefault {
  id                 String  @id @default(cuid())
  agentId            String
  // Optional branch scope. NULL means "agent-level fallback" used by any
  // branch that does not have its own override row. A non-NULL branchId
  // means this row is the override for that specific branch — looked up
  // first by getAgentDefaults(agentId, branchId).
  branchId           String?
  // Weight tiers
  tier1MinWeight     Float   @default(0)
  tier1MaxWeight     Float   @default(5)
  tier1Commission    Float   @default(1.00)
  tier2MinWeight     Float   @default(5.01)
  tier2MaxWeight     Float   @default(10)
  tier2Commission    Float   @default(1.40)
  tier3MinWeight     Float   @default(10.01)
  tier3Commission    Float   @default(2.20)
  // Bonus tiers — apply to parcels above orderThreshold (e.g. #2001+).
  // Weight ranges mirror the weight tiers above; only the commission rates
  // are independently configurable. Defaults are a 50% uplift over weight tiers.
  orderThreshold          Int     @default(2000)
  bonusTier1Commission    Float   @default(1.50)
  bonusTier2Commission    Float   @default(2.10)
  bonusTier3Commission    Float   @default(3.30)
  // Petrol
  petrolEligible     Boolean @default(true)
  dailyThreshold     Int     @default(70)
  subsidyAmount      Float   @default(15)
  useFixedTotal      Boolean @default(false)
  fixedTotalAmount   Float   @default(0)

  agent  Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([agentId, branchId])
  @@index([agentId])
}

model Account {
  id                String  @id @default(cuid())
  agentId           String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  agent             Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([agentId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  agentId      String
  expires      DateTime
  agent        Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Core Domain ─────────────────────────────────────────────

model Branch {
  id          String                 @id @default(cuid())
  agentId     String
  code        String                 // raw branch code from J&T data e.g. "PHG379"
  isDemo      Boolean                @default(false) // onboarding sample data — see src/lib/demo
  dispatchers Dispatcher[]
  assignments DispatcherAssignment[]
  employees   Employee[]
  uploads     Upload[]
  defaults    AgentDefault[]
  payRuleAssignments PayRuleAssignment[]
  payrollRuns        PayrollRun[]
  agent       Agent                  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@unique([agentId, code])
  @@index([agentId])
}

model Dispatcher {
  id             String  @id @default(cuid())
  // agentId: direct ownership by agent. Nullable in Phase A to allow the
  // additive migration on existing rows; backfilled to non-null before Phase B
  // flips it to required and drops branchId from this table.
  agentId        String?
  extId          String  // Dispatcher ID from raw data (col M) e.g. "PHG3795023". Moves to DispatcherAssignment in Phase B.
  name           String
  normalizedName String  @default("") // UPPER(TRIM(COLLAPSE_WS(name))) for fallback matching. Backfilled in Phase A.
  icNo           String? // Malaysian MyKad. Was required; now optional — matches data reality.
  gender         Gender  @default(UNKNOWN)
  avatarUrl      String?
  branchId       String  // Moves to DispatcherAssignment in Phase B.
  isPinned       Boolean @default(false)

  agent         Agent?                 @relation(fields: [agentId], references: [id], onDelete: Cascade)
  branch        Branch                 @relation(fields: [branchId], references: [id], onDelete: Cascade)
  assignments   DispatcherAssignment[]
  weightTiers   WeightTier[]
  incentiveRule IncentiveRule?
  bonusTiers    BonusTier[]
  petrolRule    PetrolRule?
  salaryRecords SalaryRecord[]
  employees     Employee[]
  payRuleAssignments PayRuleAssignment[]
  profiles           DispatcherProfile[]
  payrollResults     PayrollResult[]
  penaltyItems       PenaltyItem[]
  penaltyAliases     PenaltyAlias[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, extId])
  @@index([branchId])
  @@index([extId])
  @@index([agentId])
  @@index([agentId, icNo])
  @@index([agentId, normalizedName])
}

// A dispatcher's assignment to a specific branch. Created in Phase B backfill;
// until then this table is empty and the app continues to read branchId/extId
// directly from Dispatcher.
model DispatcherAssignment {
  id           String    @id @default(cuid())
  dispatcherId String
  branchId     String
  extId        String    // branch-scoped J&T ID
  startedAt    DateTime  @default(now())
  endedAt      DateTime? // null = still assigned

  dispatcher Dispatcher @relation(fields: [dispatcherId], references: [id], onDelete: Cascade)
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, extId])
  @@index([dispatcherId])
  @@index([branchId])
}

enum Gender {
  MALE
  FEMALE
  UNKNOWN
}

model WeightTier {
  id           String     @id @default(cuid())
  dispatcherId String
  tier         Int        // 1, 2, or 3
  minWeight    Float
  maxWeight    Float?     // null = no upper bound (tier 3)
  commission   Float      // RM flat rate per parcel in this tier
  dispatcher   Dispatcher @relation(fields: [dispatcherId], references: [id], onDelete: Cascade)

  @@unique([dispatcherId, tier])
  @@index([dispatcherId])
}

model IncentiveRule {
  id             String     @id @default(cuid())
  dispatcherId   String     @unique
  orderThreshold Int        @default(2000)
  dispatcher     Dispatcher @relation(fields: [dispatcherId], references: [id], onDelete: Cascade)
}

// Bonus tiers apply to parcels after the dispatcher crosses orderThreshold
// (e.g. parcel #2001 onward). Weight boundaries mirror WeightTier; commissions
// are independently configurable. Typically 3 rows per dispatcher.
model BonusTier {
  id           String     @id @default(cuid())
  dispatcherId String
  tier         Int        // 1, 2, or 3
  minWeight    Float
  maxWeight    Float?     // null = no upper bound (tier 3)
  commission   Float      // RM flat rate per post-threshold parcel in this tier
  dispatcher   Dispatcher @relation(fields: [dispatcherId], references: [id], onDelete: Cascade)

  @@unique([dispatcherId, tier])
  @@index([dispatcherId])
}

model PetrolRule {
  id               String     @id @default(cuid())
  dispatcherId     String     @unique
  isEligible       Boolean    @default(false)
  dailyThreshold   Int        @default(70)
  subsidyAmount    Float      @default(15)
  // Fixed-total mode — when true, the calculator skips the daily-threshold
  // count and uses fixedTotalAmount as the entire monthly petrol subsidy.
  // Independent of `isEligible`: the master switch still gates whether any
  // petrol is paid at all.
  useFixedTotal    Boolean    @default(false)
  fixedTotalAmount Float      @default(0)
  dispatcher       Dispatcher @relation(fields: [dispatcherId], references: [id], onDelete: Cascade)
}

// ─── Employees (Supervisor / Admin / Store Keeper / Driver) ──────────

enum EmployeeType {
  SUPERVISOR
  ADMIN
  STORE_KEEPER
  DRIVER
  MARKETING
  ASSISTANT
  QUALITY_CONTROL
  ACCOUNT_EXECUTIVE
}

enum StoreKeeperSubtype {
  TEMPORARY
  PERMANENT
}

enum PayMode {
  HOUR
  DAY
}

model Employee {
  id          String       @id @default(cuid())
  agentId     String
  extId       String?      // employee ID (optional external identifier)
  name        String
  icNo        String?      // optional until payslip needed
  gender      Gender       @default(UNKNOWN)
  avatarUrl   String?
  type        EmployeeType
  // Universal subtype tag (TEMPORARY / PERMANENT). Applies to every type.
  // Pay-model coupling: STORE_KEEPER (any subtype except PERMANENT) and
  // ADMIN (TEMPORARY) use hours × rate; everything else uses basicPay. The
  // chip is metadata only for Sup/Driver/Marketing/Assistant/QC/AE.
  subtype     StoreKeeperSubtype?
  branchId    String?
  isActive    Boolean      @default(true)

  // Supervisor/Admin fields
  basicPay        Float?
  petrolAllowance Float    @default(0)
  kpiAllowance    Float    @default(0)
  otAllowance     Float    @default(0)
  otherAllowance  Float    @default(0)

  // Statutory reference numbers (for payslips)
  epfNo       String?
  socsoNo     String?
  incomeTaxNo String?

  // Store Keeper fields
  hourlyWage  Float?

  // Dispatcher link
  dispatcherId String?
  dispatcher   Dispatcher? @relation(fields: [dispatcherId], references: [id], onDelete: SetNull)

  branch        Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  agent         Agent                  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  salaryRecords EmployeeSalaryRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId])
  @@index([branchId])
}

model EmployeeSalaryRecord {
  id         String @id @default(cuid())
  employeeId String
  month      Int
  year       Int

  // Earnings
  basicPay        Float @default(0)
  // For Temporary store keeper: workingHours stores units (hours OR days),
  // hourlyWage stores rate per unit. payMode disambiguates the unit for
  // payslip rendering ("WAGES (X HOUR)" vs "WAGES (X DAY)"). Null payMode
  // means HOUR (back-compat for records saved before this column existed).
  workingHours    Float    @default(0)
  hourlyWage      Float    @default(0)
  payMode         PayMode? // null treated as HOUR
  kpiAllowance    Float    @default(0)
  petrolAllowance Float    @default(0)
  otAllowance     Float    @default(0)
  otherAllowance  Float    @default(0)
  grossSalary     Float

  // Statutory (employee share)
  epfEmployee   Float
  socsoEmployee Float
  // Employee SOCSO Non-Employment Injury share ("Lindung 24 Jam" / SKBBK).
  // Deducted from net alongside socsoEmployee. Defaults 0 for records saved
  // before this column existed — those keep their stored net until re-saved.
  socsoLindung  Float @default(0)
  eisEmployee   Float
  pcb           Float @default(0) // manual

  // Statutory (employer share)
  epfEmployer   Float
  socsoEmployer Float
  eisEmployer   Float

  // Deductions
  penalty Float @default(0)
  advance Float @default(0) // combined dispatcher+employee case only

  netSalary Float

  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, month, year])
  @@index([employeeId])
  @@index([month, year])
}

// ─── Uploads & Results ───────────────────────────────────────

enum UploadStatus {
  UPLOADING
  PROCESSING
  CONFIRM_SETTINGS
  NEEDS_ATTENTION
  READY_TO_CONFIRM
  FAILED
  SAVED
}

model Upload {
  id            String         @id @default(cuid())
  branchId      String
  fileName      String
  r2Key         String
  month         Int            // 1–12
  year          Int
  status        UploadStatus   @default(UPLOADING)
  errorMessage  String?
  branch        Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  salaryRecords SalaryRecord[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([branchId, month, year])
  @@index([branchId])
  @@index([month, year])
  @@index([status])
}

model SalaryRecord {
  id           String @id @default(cuid())
  dispatcherId String
  uploadId     String
  month        Int
  year         Int

  totalOrders       Int
  baseSalary        Float
  bonusTierEarnings Float @default(0)  // total commission from parcels priced at BonusTier rate (post-threshold)
  petrolSubsidy     Float @default(0)
  commission        Float @default(0)  // manual additive commission entered by user, rolls into netSalary
  penalty           Float @default(0)
  advance           Float @default(0)
  netSalary         Float
  petrolQualifyingDays Int @default(0)

  // Snapshots of rules used for this salary calculation (JSON)
  weightTiersSnapshot Json?  // Array<{ tier, minWeight, maxWeight, commission }>
  bonusTierSnapshot   Json?  // New shape: { orderThreshold, tiers: [{tier,minWeight,maxWeight,commission}] }. Legacy shape (pre-bonus-tiers): { orderThreshold, incentiveAmount }. Use readBonusTierSnapshot to discriminate.
  petrolSnapshot      Json?  // { isEligible, dailyThreshold, subsidyAmount }

  lineItems  SalaryLineItem[]
  dispatcher Dispatcher       @relation(fields: [dispatcherId], references: [id])
  upload     Upload           @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([dispatcherId, uploadId])
  @@index([dispatcherId])
  @@index([uploadId])
  @@index([month, year])
  @@index([dispatcherId, month, year])
}

model SalaryLineItem {
  id             String       @id @default(cuid())
  salaryRecordId String
  waybillNumber  String
  weight         Float
  commission     Float
  deliveryDate   DateTime?
  isBonusTier    Boolean      @default(false) // true when this parcel was priced at the dispatcher's BonusTier (i.e. the parcel fell after orderThreshold)
  salaryRecord   SalaryRecord @relation(fields: [salaryRecordId], references: [id], onDelete: Cascade)

  @@index([salaryRecordId])
}

// ─── Payment Records (Superadmin) ────────────────────────────

model PaymentRecord {
  id        String   @id @default(cuid())
  agentId   String
  amount    Float
  date      DateTime
  notes     String?
  period    String?  // e.g. "March 2026 – February 2027"
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([agentId])
}

// Monthly subscription invoice (branch limit × price). One row per agent per
// month, created when the invoice is sent or the month is marked paid.
model Invoice {
  id          String    @id @default(cuid())
  agentId     String
  year        Int
  month       Int       // 1–12
  branchCount Int
  unitPrice   Float
  amount      Float
  sentAt      DateTime?
  paidAt      DateTime? // null = unpaid
  remindedAt  DateTime? // due-date reminder sent
  // Billplz bill for online payment; replaced when the amount changes
  billplzBillId String?   @unique
  billplzUrl    String?
  billplzAmount Float?
  agent       Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([agentId, year, month])
  @@index([agentId])
}

// Audit log of branch-limit changes, by the agent (Settings → Plan) or an admin.
model BranchLimitChange {
  id         String   @id @default(cuid())
  agentId    String
  fromLimit  Int
  toLimit    Int
  changedBy  String   // "agent" | "admin"
  actorEmail String?
  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([agentId, createdAt])
}

// ─── Notifications ───────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  agentId   String
  type      String   // "upload" | "payroll" | "new_dispatcher" | "recalculate"
  message   String
  detail    String
  isRead    Boolean  @default(false)
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([agentId, isRead])
  @@index([agentId, createdAt])
}

// ─── v2: config-driven pay rules and payroll runs ─────────────
// Used only by v2 accounts (/app). Rule numbers are JSON validated by
// src/lib/v2/pay/config.ts; money is stored in cents; months are yyyymm Ints.

enum Vehicle {
  BIKE
  CAR
  LORRY
}

enum Employment {
  FULL_TIME
  PART_TIME
}

enum PayRuleKind {
  PARCEL
  KPI
  FUEL
  SC
  SC_RTN
  ALLOWANCE
  DEDUCTION
  PENALTY
}

enum PayrollRunStatus {
  DRAFT
  FINAL
}

/// A named pay rule: a rate card, the KPI card, a fuel rule. Its numbers live in
/// month-versioned PayRuleVersion rows; who it applies to, in PayRuleAssignment.
model PayRule {
  id          String              @id @default(cuid())
  agentId     String
  kind        PayRuleKind
  name        String
  archivedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  agent       Agent               @relation(fields: [agentId], references: [id], onDelete: Cascade)
  versions    PayRuleVersion[]
  assignments PayRuleAssignment[]

  @@index([agentId, kind])
}

/// A rule's tiers and rates from `effectiveFrom` on. A change is a new version, so
/// months before it keep their numbers.
model PayRuleVersion {
  id            String   @id @default(cuid())
  ruleId        String
  effectiveFrom Int
  config        Json
  source        String?
  createdBy     String?
  createdAt     DateTime @default(now())
  rule          PayRule  @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, effectiveFrom])
}

/// Who a rule applies to from `effectiveFrom` on. Per kind the most specific match
/// wins: dispatcher > outlet > FT/PT > everyone (all scope fields null).
model PayRuleAssignment {
  id            String      @id @default(cuid())
  agentId       String
  kind          PayRuleKind
  ruleId        String
  branchId      String?
  dispatcherId  String?
  employment    Employment?
  effectiveFrom Int
  createdAt     DateTime    @default(now())
  rule          PayRule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  branch        Branch?     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  dispatcher    Dispatcher? @relation(fields: [dispatcherId], references: [id], onDelete: Cascade)

  @@index([agentId, kind])
  @@index([ruleId])
}

/// A dispatcher's vehicle and full/part-time status from `effectiveFrom` on.
model DispatcherProfile {
  id            String     @id @default(cuid())
  dispatcherId  String
  effectiveFrom Int
  vehicle       Vehicle
  employment    Employment
  /// Set when someone confirms a change from last month's vehicle/type is right for this month's pay.
  /// Saving the month again makes a new row, so a later change needs confirming again.
  confirmedAt   DateTime?
  createdAt     DateTime   @default(now())
  dispatcher    Dispatcher @relation(fields: [dispatcherId], references: [id], onDelete: Cascade)

  @@unique([dispatcherId, effectiveFrom])
}

/// One outlet's payroll for one month, from one J&T delivery file. A FINAL run is
/// never recalculated; `rules` keeps every rule version it used.
model PayrollRun {
  id           String           @id @default(cuid())
  agentId      String
  branchId     String
  period       Int
  status       PayrollRunStatus @default(DRAFT)
  fileName     String
  r2Key        String
  parcelCount  Int
  rules        Json?
  /// What the file held: rows read, rows from other outlets or months.
  stats        Json?
  calculatedAt DateTime?
  finalisedAt  DateTime?
  finalisedBy  String?
  /// Set when the month's penalty files were imported, or there were none, in the New payroll steps.
  /// A run can't be finalised before.
  penaltiesCheckedAt DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  agent        Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  branch       Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  results      PayrollResult[]

  @@unique([branchId, period])
  @@index([agentId, period])
}

/// One dispatcher in a run: their parcels (compact, in delivery order) and computed pay.
model PayrollResult {
  id             String     @id @default(cuid())
  runId          String
  dispatcherId   String
  extId          String
  name           String
  parcels        Json
  profile        Json?
  lines          Json
  /// Why a dispatcher isn't fully paid (no vehicle/type, a rule without rates).
  warnings       Json?
  /// The penalty cases deducted, as they were when calculated (itemised on the payslip).
  penalties      Json?
  earningsCents  Int        @default(0)
  deductionCents Int        @default(0)
  netCents       Int        @default(0)
  run            PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  dispatcher     Dispatcher @relation(fields: [dispatcherId], references: [id], onDelete: Cascade)

  @@unique([runId, dispatcherId])
  @@index([dispatcherId])
}

/// Who changed which rule, assignment or profile, and when.
model RuleAudit {
  id        String   @id @default(cuid())
  agentId   String
  ruleId    String?
  action    String
  detail    Json?
  actor     String?
  createdAt DateTime @default(now())
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
  @@index([ruleId])
}

/// J&T HQ QC penalty types.
enum PenaltyType {
  FAKE_ATTEMPT
  FAKE_POP
  PDNC
  INACTIVE
  POD
  COD_LATE
  COD_ISSUE
  LOST
  LATE_ARRIVAL
  OTHER
}

enum PenaltyStatus {
  MATCHED
  UNMATCHED
  IGNORED
}

/// One penalty file imported into a month. Items point at the import that added them.
model PenaltyImport {
  id        String        @id @default(cuid())
  agentId   String
  period    Int
  fileName  String
  /// Cases read from the file, and how many were new or changed.
  rows      Int
  added     Int
  updated   Int
  actor     String?
  createdAt DateTime      @default(now())
  agent     Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  items     PenaltyItem[]

  @@index([agentId, period])
}

/// One penalty case from a J&T QC file. Unique per month, type and key, so importing the
/// same cases again updates them instead of counting them twice.
model PenaltyItem {
  id           String        @id @default(cuid())
  agentId      String
  importId     String
  period       Int
  type         PenaltyType
  key          String
  waybill      String?
  /// The dispatcher as the file names them; matching links `dispatcherId`.
  extId        String?
  name         String?
  /// "id:<J&T ID>" or "name:<normalized name>": a manual match or ignore applies to every case with the same.
  who          String?
  outlet       String?
  occurredAt   DateTime?
  /// The amount in the file, if it has one. A penalty rule, when one applies, decides instead.
  amountCents  Int?
  appeal       String?
  note         String?
  waived       Boolean       @default(false)
  /// Set when someone waived or un-waived by hand; imports then keep that choice.
  waivedBy     String?
  status       PenaltyStatus @default(UNMATCHED)
  dispatcherId String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  agent        Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  file         PenaltyImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  dispatcher   Dispatcher?   @relation(fields: [dispatcherId], references: [id], onDelete: SetNull)

  @@unique([agentId, period, type, key])
  @@index([agentId, period, status])
  @@index([agentId, who])
  @@index([dispatcherId, period])
}

/// A manual decision for penalty rows naming someone the matcher couldn't place:
/// "id:<J&T ID>" or "name:<normalized name>" -> a dispatcher, or none to ignore them.
model PenaltyAlias {
  id           String      @id @default(cuid())
  agentId      String
  key          String
  dispatcherId String?
  actor        String?
  createdAt    DateTime    @default(now())
  agent        Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  dispatcher   Dispatcher? @relation(fields: [dispatcherId], references: [id], onDelete: Cascade)

  @@unique([agentId, key])
}

/// A month's pay compared with the account's own payroll sheet (reconciliation). One per month:
/// uploading the sheet again replaces it and keeps the notes on differences.
model PayrollCheck {
  id        String   @id @default(cuid())
  agentId   String
  period    Int
  fileName  String
  /// Which sheet columns hold the person and which figures (see src/lib/v2/payroll/reconcile.ts).
  plan      Json
  /// The sheet's people and figures as read.
  people    Json
  /// Explanations by line key: { note, excluded }.
  notes     Json?
  actor     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, period])
}
